-- ============================================================
-- DATABASE SISTEM INFORMASI AKUNTANSI
-- Voucher Kas Keluar
-- Compatible dengan frontend yang diberikan
-- ============================================================

-- ============================================================
-- 1. HAPUS OBJEK LAMA (OPSIONAL)
-- ============================================================
-- PERHATIAN:
-- Bagian ini akan menghapus tabel lama jika ada.
-- Jangan jalankan jika sudah memiliki data penting.

DROP TABLE IF EXISTS audit_log CASCADE;
DROP TABLE IF EXISTS journal_lines CASCADE;
DROP TABLE IF EXISTS journal_headers CASCADE;
DROP TABLE IF EXISTS chart_of_accounts CASCADE;


-- ============================================================
-- 2. TABEL CHART OF ACCOUNTS
-- ============================================================

CREATE TABLE chart_of_accounts (
    account_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    account_code VARCHAR(20) NOT NULL UNIQUE,
    account_name VARCHAR(150) NOT NULL,

    normal_balance VARCHAR(10) NOT NULL
        CHECK (normal_balance IN ('DEBIT', 'CREDIT')),

    report_classification VARCHAR(30) NOT NULL,

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);


-- ============================================================
-- 3. TABEL JOURNAL HEADERS
-- ============================================================

CREATE TABLE journal_headers (
    journal_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    trx_date DATE NOT NULL,

    ref_no VARCHAR(50) NOT NULL UNIQUE,

    description TEXT NOT NULL,

    status VARCHAR(20) NOT NULL DEFAULT 'POSTED'
        CHECK (status IN ('DRAFT', 'POSTED')),

    total_debit NUMERIC(18,2) NOT NULL DEFAULT 0,

    total_credit NUMERIC(18,2) NOT NULL DEFAULT 0,

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    posted_at TIMESTAMPTZ
);


-- ============================================================
-- 4. TABEL JOURNAL LINES
-- ============================================================

CREATE TABLE journal_lines (
    journal_line_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    journal_id BIGINT NOT NULL,

    account_id BIGINT NOT NULL,

    debit NUMERIC(18,2) NOT NULL DEFAULT 0,

    credit NUMERIC(18,2) NOT NULL DEFAULT 0,

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    CONSTRAINT fk_journal
        FOREIGN KEY (journal_id)
        REFERENCES journal_headers(journal_id),

    CONSTRAINT fk_account
        FOREIGN KEY (account_id)
        REFERENCES chart_of_accounts(account_id),

    -- Debit dan kredit tidak boleh negatif
    CONSTRAINT chk_non_negative
        CHECK (debit >= 0 AND credit >= 0),

    -- Satu baris hanya boleh debit ATAU kredit
    CONSTRAINT chk_debit_or_credit
        CHECK (
            (debit > 0 AND credit = 0)
            OR
            (credit > 0 AND debit = 0)
        )
);


-- ============================================================
-- 5. INDEX
-- ============================================================

CREATE INDEX idx_journal_headers_trx_date
ON journal_headers(trx_date);

CREATE INDEX idx_journal_headers_ref_no
ON journal_headers(ref_no);

CREATE INDEX idx_journal_lines_journal_id
ON journal_lines(journal_id);

CREATE INDEX idx_journal_lines_account_id
ON journal_lines(account_id);


