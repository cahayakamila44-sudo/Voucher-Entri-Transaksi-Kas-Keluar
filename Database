-- ============================================================
-- 7. AUDIT LOG
-- Untuk kebutuhan audit trail Soal 3.2
-- ============================================================

CREATE TABLE audit_log (
    audit_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    table_name VARCHAR(100) NOT NULL,

    record_id BIGINT NOT NULL,

    action VARCHAR(20) NOT NULL,

    old_data JSONB,

    new_data JSONB,

    changed_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);


-- ============================================================
-- 8. FUNGSI AUDIT JOURNAL HEADER
-- ============================================================

CREATE OR REPLACE FUNCTION fn_audit_journal_headers()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN

    IF TG_OP = 'INSERT' THEN

        INSERT INTO audit_log (
            table_name,
            record_id,
            action,
            new_data
        )
        VALUES (
            'journal_headers',
            NEW.journal_id,
            'INSERT',
            to_jsonb(NEW)
        );

        RETURN NEW;

    ELSIF TG_OP = 'UPDATE' THEN

        INSERT INTO audit_log (
            table_name,
            record_id,
            action,
            old_data,
            new_data
        )
        VALUES (
            'journal_headers',
            OLD.journal_id,
            'UPDATE',
            to_jsonb(OLD),
            to_jsonb(NEW)
        );

        RETURN NEW;

    ELSIF TG_OP = 'DELETE' THEN

        INSERT INTO audit_log (
            table_name,
            record_id,
            action,
            old_data
        )
        VALUES (
            'journal_headers',
            OLD.journal_id,
            'DELETE',
            to_jsonb(OLD)
        );

        RETURN OLD;

    END IF;

END;
$$;


-- ============================================================
-- 9. TRIGGER AUDIT
-- ============================================================

CREATE TRIGGER trg_audit_journal_headers
AFTER INSERT OR UPDATE OR DELETE
ON journal_headers
FOR EACH ROW
EXECUTE FUNCTION fn_audit_journal_headers();


-- ============================================================
-- 10. RPC CREATE POSTED JOURNAL
--
-- Nama dan parameter HARUS sesuai frontend:
--
-- rpc_create_posted_journal
-- p_trx_date
-- p_ref_no
-- p_description
-- p_lines
-- ============================================================

CREATE OR REPLACE FUNCTION rpc_create_posted_journal(
    p_trx_date DATE,
    p_ref_no TEXT,
    p_description TEXT,
    p_lines JSONB
)
RETURNS BIGINT
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE

    v_journal_id BIGINT;

    v_line JSONB;

    v_account_id BIGINT;

    v_debit NUMERIC(18,2);

    v_credit NUMERIC(18,2);

    v_total_debit NUMERIC(18,2) := 0;

    v_total_credit NUMERIC(18,2) := 0;

    v_line_count INTEGER := 0;

BEGIN

    -- ========================================================
    -- VALIDASI HEADER
    -- ========================================================

    IF p_trx_date IS NULL THEN
        RAISE EXCEPTION
        'Tanggal transaksi wajib diisi.';
    END IF;


    IF p_ref_no IS NULL
       OR BTRIM(p_ref_no) = '' THEN

        RAISE EXCEPTION
        'Nomor referensi wajib diisi.';

    END IF;


    IF p_description IS NULL
       OR BTRIM(p_description) = '' THEN

        RAISE EXCEPTION
        'Deskripsi transaksi wajib diisi.';

    END IF;


    -- ========================================================
    -- VALIDASI JSON
    -- ========================================================

    IF p_lines IS NULL
       OR jsonb_typeof(p_lines) <> 'array' THEN

        RAISE EXCEPTION
        'Detail jurnal harus berbentuk JSON array.';

    END IF;


    v_line_count := jsonb_array_length(p_lines);


    IF v_line_count < 2 THEN

        RAISE EXCEPTION
        'Jurnal minimal memiliki 2 baris.';

    END IF;


    -- ========================================================
    -- HITUNG DAN VALIDASI DETAIL
    -- ========================================================

    FOR v_line IN
        SELECT value
        FROM jsonb_array_elements(p_lines)
    LOOP

        v_account_id :=
            (v_line ->> 'account_id')::BIGINT;

        v_debit :=
            COALESCE(
                (v_line ->> 'debit')::NUMERIC,
                0
            );

        v_credit :=
            COALESCE(
                (v_line ->> 'credit')::NUMERIC,
                0
            );


        -- Akun wajib ada
        IF v_account_id IS NULL THEN

            RAISE EXCEPTION
            'Account ID wajib diisi.';

        END IF;


        IF NOT EXISTS (
            SELECT 1
            FROM chart_of_accounts
            WHERE account_id = v_account_id
        ) THEN

            RAISE EXCEPTION
            'Account ID % tidak ditemukan.',
            v_account_id;

        END IF;


        -- Tidak boleh negatif
        IF v_debit < 0 OR v_credit < 0 THEN

            RAISE EXCEPTION
            'Debit dan kredit tidak boleh negatif.';

        END IF;


        -- Tidak boleh debit dan kredit sekaligus
        IF v_debit > 0 AND v_credit > 0 THEN

            RAISE EXCEPTION
            'Satu baris tidak boleh memiliki debit dan kredit sekaligus.';

        END IF;


        -- Tidak boleh keduanya nol
        IF v_debit = 0 AND v_credit = 0 THEN

            RAISE EXCEPTION
            'Setiap baris harus memiliki nilai debit atau kredit.';

        END IF;


        v_total_debit :=
            v_total_debit + v_debit;

        v_total_credit :=
            v_total_credit + v_credit;

    END LOOP;


    -- ========================================================
    -- PENEGAKAN DOUBLE ENTRY
    -- ========================================================

    IF v_total_debit <= 0 THEN

        RAISE EXCEPTION
        'Total jurnal harus lebih besar dari nol.';

    END IF;


    IF v_total_debit <> v_total_credit THEN

        RAISE EXCEPTION
        'Jurnal tidak balance. Total debit = %, total kredit = %.',
        v_total_debit,
        v_total_credit;

    END IF;


    -- ========================================================
    -- CEK NOMOR REFERENSI
    -- ========================================================

    IF EXISTS (
        SELECT 1
        FROM journal_headers
        WHERE ref_no = BTRIM(p_ref_no)
    ) THEN

        RAISE EXCEPTION
        'Nomor referensi % sudah digunakan.',
        p_ref_no;

    END IF;


    -- ========================================================
    -- INSERT HEADER
    -- ========================================================

    INSERT INTO journal_headers (
        trx_date,
        ref_no,
        description,
        status,
        total_debit,
        total_credit,
        posted_at
    )
    VALUES (
        p_trx_date,
        BTRIM(p_ref_no),
        BTRIM(p_description),
        'POSTED',
        v_total_debit,
        v_total_credit,
        NOW()
    )
    RETURNING journal_id
    INTO v_journal_id;


    -- ========================================================
    -- INSERT JOURNAL LINES
    -- ========================================================

    FOR v_line IN
        SELECT value
        FROM jsonb_array_elements(p_lines)
    LOOP

        INSERT INTO journal_lines (
            journal_id,
            account_id,
            debit,
            credit
        )
        VALUES (
            v_journal_id,

            (v_line ->> 'account_id')::BIGINT,

            COALESCE(
                (v_line ->> 'debit')::NUMERIC,
                0
            ),

            COALESCE(
                (v_line ->> 'credit')::NUMERIC,
                0
            )
        );

    END LOOP;


    -- ========================================================
    -- RETURN ID KE FRONTEND
    -- ========================================================

    RETURN v_journal_id;

END;
$$;


-- ============================================================
-- 11. ROW LEVEL SECURITY
-- ============================================================

ALTER TABLE chart_of_accounts
ENABLE ROW LEVEL SECURITY;

ALTER TABLE journal_headers
ENABLE ROW LEVEL SECURITY;

ALTER TABLE journal_lines
ENABLE ROW LEVEL SECURITY;

ALTER TABLE audit_log
ENABLE ROW LEVEL SECURITY;


-- ============================================================
-- 12. POLICY COA
-- Frontend membutuhkan SELECT COA menggunakan anon key
-- ============================================================

CREATE POLICY "Allow public read chart of accounts"
ON chart_of_accounts
FOR SELECT
TO anon, authenticated
USING (true);


-- ============================================================
-- 13. IZIN MENJALANKAN RPC
-- ============================================================

GRANT EXECUTE
ON FUNCTION rpc_create_posted_journal(
    DATE,
    TEXT,
    TEXT,
    JSONB
)
TO anon, authenticated;


-- ============================================================
-- 14. IZIN SELECT COA
-- ============================================================

GRANT SELECT
ON chart_of_accounts
TO anon, authenticated;


